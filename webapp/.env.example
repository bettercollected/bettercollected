# API Configuration
NEXT_PUBLIC_API_ENDPOINT_HOST=http://localhost:8000/api/v1
INTERNAL_DOCKER_API_ENDPOINT_HOST=http://localhost:8000/api/v1

HTTP_SCHEME=http://

# Custom domains (docs/custom-domain.md). Leave the assertion keys and
# application id empty to keep resolving the workspace from the request host.
# Hosted service: the key id starts with app_ (Origin tab, "Get your assertion key").
CUSTOM_DOMAIN_ASSERTION_KEYS=
CUSTOM_DOMAIN_APPLICATION_ID=
CUSTOM_DOMAIN_ASSERTION_MODE=optional
CUSTOM_DOMAIN_ORIGIN_VERIFICATION_TOKEN=

# Analytics & Monitoring (self-hosted Umami — see
# plans/umami-self-hosted-form-analytics.md). `docker compose -f
# docker-compose.local.yml up` starts Umami at http://localhost:3003 (default
# login admin/umami); create a website there and paste its id below. The
# script is only rendered when both vars are set.
UMAMI_SCRIPT_URL=http://localhost:3003/script.js
UMAMI_WEBSITE_ID=

# Elastic APM
ELASTIC_APM_API_KEY=
ELASTIC_APM_SERVICE_NAME=Bettercollected-Webapp
ELASTIC_APM_SERVER_URL=https://apm.sireto.io
ELASTIC_APM_ENVIRONMENT=local

GOOGLE_CLIENT_ID=
GOOGLE_PICKER_API_KEY=

UNSPLASH_ACCESS_KEY=

# Locally one Next app serves both dashboard and forms — point FORM_DOMAIN at it.
FORM_DOMAIN=localhost:3000
DASHBOARD_DOMAIN=localhost:3000
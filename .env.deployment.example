# Template for .env.deployment, the container environment of the services
# (compose `env_file`). This file is tracked; .env.deployment is not (it is
# git-ignored). deploy.sh creates .env.deployment from this template, mode 600,
# when it is missing, and never overwrites an existing one. Without deploy.sh:
#   (umask 077; cp .env.deployment.example .env.deployment)
# Put your own values in .env.deployment only, never in this template.
#
# Every value below is a non-secret default or an empty placeholder. No secret
# belongs here: deploy.sh generates the stack's secrets into the root .env and
# the settings store (docs/admin-service.md, "Deploying with deploy.sh").
#
# In 4.0 most of the settings below live in the settings store
# (docs/settings-loader.md): deploy.sh imports the values found in
# .env.deployment once, and `deploy.sh settings-prune` then removes them from
# it. A non-empty value in .env.deployment still WINS over the store, so a stale
# line silently overrides a change made in the portal: prune it.
#
# Not set here on purpose: DEBUG and API_DOCS_ENABLED (both default to off; set
# one in the portal, or in .env.deployment as a deliberate override), and every
# key deploy.sh generates (docs/admin-service.md).
#
# Who reads .env.deployment: only the backend, the jobs worker, auth and the
# Google integration (the services that read the settings store and so already
# hold the master key). The webapp and the Temporal worker each get a file of
# their own (.env.webapp, .env.worker): deploy.sh creates it once, with mode
# 600, from the lines of .env.deployment those services read (never
# overwriting it), and never gives them anything else. Edit those files for
# those services.

# Webapp feature flags (defaults of this release)
ENABLE_COMMAND_FORM_BUILDERS=true
ENABLE_FORM_BUILDER=true

# Auth — AUTH_JWT_SECRET (signs sessions) and AUTH_AES_HEX_KEY (a Fernet key)
# are not set here. On a new stack `bootstrap-keys` generates them into the
# settings store; on an upgrade deploy.sh imports the values the stack has used
# so far (from the root .env, or copied from .env.deployment by
# deploy/generate-secrets.sh). The services refuse a value that was ever
# published in this repository.

# Mongo — MONGO_URI is not set here. Since 4.1 the stack runs on Postgres only:
# a new stack has no MongoDB and no MONGO_URI. An upgrade from 4.0 imports its
# Mongo data into Postgres once (deploy.sh, docs/postgres-cutover-runbook.md
# "Upgrading to 4.1") and then blanks a MONGO_URI it finds here.

# Postgres (app database) — no key needed here: docker-compose.deployment.yml
# injects DATABASE_URL per service from the passwords deploy.sh generates into
# the root .env on first run (docs/admin-service.md).

# Stripe — from your Stripe dashboard (product id, secret API key, webhook
# signing secret). Leave empty to run without billing. The two URLs are the
# address your users open the webapp at (localhost for a local trial).
STRIPE_PRODUCT_ID=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_REDIRECT_URL=http://localhost:3000/refresh-token
CLIENT_ADMIN_URL=http://localhost:3000

# Google — from the OAuth client you create in your Google Cloud project
# (client id, project id, client secret, scopes). Leave empty without the
# Google Forms integration. The origins and redirect URIs are your own public
# addresses (localhost for a local trial) and must match the OAuth client.
GOOGLE_SCOPES=
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_JAVASCRIPT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
GOOGLE_BASIC_AUTH_REDIRECT=http://localhost:8000/api/v1/auth/google/basic/callback
GOOGLE_REDIRECT_URIS=http://localhost:8000/api/v1/auth/google/oauth/callback
# Plain-http OAuth redirects (local development only) need
# OAUTHLIB_INSECURE_TRANSPORT=1; it is deliberately not set here, because it
# switches off the HTTPS requirement of the OAuth flow. Use https URLs in a
# deployment, or add the line yourself on a machine nobody else can reach.
OAUTHLIB_RELAX_TOKEN_SCOPE=1
# Google Forms import: on (default), readonly (forms and responses imported
# earlier stay readable; no new import, re-sync or call to Google) or off
# (the Google Forms endpoints answer 410; the service is never called).
GOOGLE_FORMS_IMPORT=on
# Google Sheets action: google_service (default; the Google Forms service runs
# the OAuth flow) or backend (the backend runs it with the client above and
# only the drive.file scope; see docs/RUNNING_INTEGRATIONS.md first). The
# redirect address is the web app's callback page.
GOOGLE_SHEETS_OAUTH=google_service
GOOGLE_SHEET_REDIRECT_URL=http://localhost:3000/integrations/google/callback

# Temporal worker — the service names inside the compose network; keep them
# unless you changed the compose file.
SERVER_URL=http://backend:8000/api/v1
TEMPORAL_SERVER_URL=temporal:7233
TEMPORAL_SERVER_URI=temporal:7233
# API_KEY (worker) / TEMPORAL_API_KEY (backend): not set here. The worker keeps
# its API_KEY and AES_HEX_KEY in the root .env (it never reads the settings
# store or gets the master key); deploy.sh writes both there.
NAMESPACE=default
TEMPORAL_NAMESPACE=default
# AES_HEX_KEY (worker): a copy of the stack's AUTH_AES_HEX_KEY, see above.

# Umami (self-hosted product analytics). deploy.sh seeds UMAMI_URL (the
# internal docker network address) and replaces Umami's built-in admin/umami
# login with a generated password, stored as the UMAMI_PASSWORD setting: leave
# UMAMI_PASSWORD empty. Leave UMAMI_WEBSITE_ID empty: the backend
# auto-provisions a website on startup and finds it again on every restart
# (find-or-create by name — see backend/AGENTS.md "Analytics (Umami)").
# UMAMI_SCRIPT_URL is browser-facing — point it at wherever you expose the
# umami service publicly (e.g. http://<host>:3003/script.js, or a
# reverse-proxied domain).
UMAMI_USERNAME=admin
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=

# Mail — your SMTP provider's server, port, account and sender address. The
# admin portal's sign-in mail reads MAIL_* from the root .env instead
# (docs/admin-service.md).
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_SERVER=
MAIL_SMTP_PORT=587
MAIL_SENDER=

# Encryption — MASTER_ENCRYPTION_KEYSET (the Tink keyset responses are
# encrypted with) is not set here either: `bootstrap-keys` generates it into the
# settings store on a new stack. A stack that already holds responses keeps the
# keyset it has used: deploy.sh imports it from its old place (see CHANGELOG.md).

# Internal admin service: its settings (ADMIN_PORT, ADMIN_ALLOWED_IPS,
# ADMIN_TRUSTED_PROXIES, ADMIN_EDGE_SUBNET, ...) are read by docker compose from
# the root .env, not from .env.deployment, so a line there has no effect. See
# docs/admin-service.md.

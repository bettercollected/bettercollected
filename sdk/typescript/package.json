{
  "name": "@bettercollected/sdk",
  "version": "0.1.0",
  "description": "Typed client for the BetterCollected public API (forms as code).",
  "license": "SEE LICENSE IN ../../LICENSE",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/public-v1.openapi.json -o src/generated/openapi.ts && node scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}

{
  "name": "@bettercollected/sdk",
  "version": "0.1.0",
  "description": "Typed client for the BetterCollected public API (forms as code).",
  "license": "Apache-2.0",
  "author": "Sireto B.V.",
  "homepage": "https://bettercollected.com/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bettercollected/bettercollected.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/bettercollected/bettercollected/issues"
  },
  "keywords": [
    "bettercollected",
    "forms",
    "forms-as-code",
    "form-builder",
    "privacy",
    "gdpr",
    "api-client",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/public-v1.openapi.json -o src/generated/openapi.ts && node scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}

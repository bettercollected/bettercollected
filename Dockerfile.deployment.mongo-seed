FROM mongo:latest

COPY ./seed-data-deployment.js .

# This should run only when running your app through docker-compose.
# MONGO_ROOT_PASSWORD comes from the compose service (default: the original "root")
# and is read by the script from the environment: --nodb keeps it out of the
# command line (and so out of the process list).
CMD ["mongosh", "--nodb", "--quiet", "./seed-data-deployment.js"]

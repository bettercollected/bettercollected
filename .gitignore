.idea/
node_modules/
webapp/.yarn
.env
.env.local
.DS_Store
# local document-sandbox socket (docker-compose.local.yml)
/.run/
# single sign-on local dev secrets (scripts/sso-dev-setup.sh)
.sso-dev/
# keyset rotation files (docs/response-keyset-rotation.md)
/keyset-rotation/
*.keyset
.env.pre-v4.*
.env.deployment.pre-v4.*
.env.*.pruned
.env.deployment.pre-umami.*
# Generated or operator-edited secret files. Every .env.* file is ignored except
# the shipped examples/templates: the pruned exports (.env.pruned,
# .env.deployment.pruned), per-service env files (.env.webapp, .env.worker,
# .env.typeform), backups and the temp files a crashed run can leave behind
# (.env.XXXXXX), and .env.deployment itself (deploy.sh creates it from the tracked
# .env.deployment.example; operators fill it with their own values).
.env.*
!.env.example
!.env.deployment.example

# Python bytecode (e.g. from running .github/scripts tests)
__pycache__/

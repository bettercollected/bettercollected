# The internal APIs serve no /docs, /redoc or /openapi.json unless this is true.
API_DOCS_ENABLED=false

# Debug mode shows HTML tracebacks for unhandled errors; keep it off here.
DEBUG=false

#Webapp
ENABLE_COMMAND_FORM_BUILDERS=true
ENABLE_FORM_BUILDER=true

# Auth — AUTH_JWT_SECRET (signs sessions) and AUTH_AES_HEX_KEY (a Fernet key)
# are not set here. deploy.sh generates both into the root .env on first run
# (deploy/generate-secrets.sh) and docker-compose.deployment.yml passes them to
# the services, which refuse to start without them or with a value that was
# ever published in this repository. Values set here are ignored by that
# compose file; on its first run deploy.sh copies them into the root .env.

# Mongo
MONGO_URI=mongodb://root:root@mongodb:27017

# Postgres (app database) — no key needed here: docker-compose.deployment.yml
# injects DATABASE_URL per service from the passwords deploy.sh generates into
# the root .env on first run (see plans/postgres-consolidation.md).

# Stripe
STRIPE_PRODUCT_ID=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_REDIRECT_URL=http://localhost:3000/refresh-token
CLIENT_ADMIN_URL=http://localhost:3000

# Google
GOOGLE_SCOPES=
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_JAVASCRIPT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
GOOGLE_BASIC_AUTH_REDIRECT=http://localhost:8000/api/v1/auth/google/basic/callback
GOOGLE_REDIRECT_URIS=http://localhost:8000/api/v1/auth/google/oauth/callback
OAUTHLIB_INSECURE_TRANSPORT=1
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Typeform
TYPEFORM_BASIC_SCOPE=
TYPEFORM_SCOPE=
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
TYPEFORM_BASIC_REDIRECT_URI=http://localhost:8000/api/v1/auth/typeform/basic/callback
TYPEFORM_REDIRECT_URI=http://localhost:8000/api/v1/auth/typeform/oauth/callback

#Temporal Worker
SERVER_URL=http://backend:8000/api/v1
TEMPORAL_SERVER_URL=temporal:7233
TEMPORAL_SERVER_URI=temporal:7233
# API_KEY (worker) / TEMPORAL_API_KEY (backend): not set here. deploy.sh
# generates TEMPORAL_API_KEY into the root .env on first run and
# docker-compose.deployment.yml passes it to the backend and the worker.
NAMESPACE=default
TEMPORAL_NAMESPACE=default
# AES_HEX_KEY (worker): the root .env's AUTH_AES_HEX_KEY, passed by
# docker-compose.deployment.yml.

# Umami (self-hosted product analytics — see
# plans/umami-self-hosted-form-analytics.md). UMAMI_URL is set on the backend
# service itself in docker-compose.deployment.yml (internal docker network).
# USERNAME/PASSWORD must match whatever admin login you set inside Umami
# itself (default admin/umami on first boot — change it at http://<host>:3003
# and update PASSWORD here to match). Leave WEBSITE_ID blank: the backend
# auto-provisions a website on startup and finds it again on every restart
# (find-or-create by name — see backend/AGENTS.md "Analytics (Umami)").
# UMAMI_SCRIPT_URL is browser-facing — point it at wherever you expose the
# umami service publicly (e.g. http://<host>:3003/script.js, or a
# reverse-proxied domain).
UMAMI_USERNAME=admin
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=

#Mail
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_SERVER=
MAIL_SMTP_PORT=587
MAIL_SENDER=

# Encryption — MASTER_ENCRYPTION_KEYSET (the Tink keyset responses are
# encrypted with) is not set here either: deploy.sh generates it into the root
# .env on a new stack. A stack that already holds responses must keep the
# keyset it has used (see CHANGELOG.md).

# Internal admin service (docs/admin-service.md): no secrets here.
# Host port, published on 127.0.0.1 only
ADMIN_PORT=8100
# Client addresses allowed in (CIDRs, comma-separated). The Docker gateway of
# the admin network is added through ADMIN_EDGE_GATEWAY.
ADMIN_ALLOWED_IPS=127.0.0.1/32
# ADMIN_ALLOWED_HOSTS=localhost:8100,127.0.0.1:8100
# Proxies whose X-Forwarded-For is believed; empty trusts none
ADMIN_TRUSTED_PROXIES=
ADMIN_EDGE_SUBNET=172.30.77.0/29
ADMIN_EDGE_GATEWAY=172.30.77.1

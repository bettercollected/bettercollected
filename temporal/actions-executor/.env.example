SERVER_URL=

TEMPORAL_SERVER_URL=

# Required: the backend's TEMPORAL_API_KEY (same value). Unset or
# "random_api_key" is refused by the backend.
API_KEY=

NAMESPACE=

AES_HEX_KEY=
ELASTIC_APM_API_KEY=
ELASTIC_APM_ENVIRONMENT=
ELASTIC_APM_ENABLED=
ELASTIC_APM_SERVICE_NAME=
# Instance name in the From name of a respondent copy ("<workspace> via <name>")
ORGANIZATION_NAME="Better Collected"

# Isolation of custom action code and of outgoing calls (docs/executor-isolation.md).
# enforce (the default): the backend opens each run's secrets, so AES_HEX_KEY is no
# longer needed (leave it only while the backend is older than 4.3); legacy is the
# pre-4.3 in-process run, a way back only.
ACTION_ISOLATION=enforce
# Hosts actions may call although they are internal or not https: host or host:port,
# comma separated. Empty: public https only.
ACTION_EGRESS_ALLOW=

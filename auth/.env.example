DEBUG="false"
# Api
API_ENVIRONMENT=local
API_ROOT_PATH=/api/v1
# Mongo
MONGO_DB=bettercollected_auth
MONGO_URI=mongodb://<USER>:<PASSWORD>@localhost:27017
# Postgres — the application database replacing MongoDB and Temporal
# (plans/postgres-consolidation.md). One role per service; the local compose
# stack (docker-compose.local.yml, service app-postgres) creates these on first start.
# Mongo/Postgres switching (plans/postgres-consolidation.md): one repository group, "auth".
#   DB_READ_SOURCE=mongo|postgres     DB_WRITE_MODE=mongo|dual|postgres_primary_dual|postgres
#   DB_SHADOW_READ_SAMPLE=0.0..1.0    (per-group overrides: DB_READ_SOURCE__auth=...)
# Flips take effect on restart; without DATABASE_URL every flag must stay at its Mongo default.
DATABASE_URL=postgresql+asyncpg://bc_auth:bc_auth@localhost:5432/bettercollected
# Mail
MAIL_USER=EMAIL_ADDRESS
MAIL_PASSWORD=APP_PASSWORD or EMAIL ADDRESS PASSWORD
MAIL_SMTP_SERVER=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SENDER="BetterCollected <no-reply@example.com>"
# Google
GOOGLE_CLIENT_TYPE=web
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=http://localhost:8000/api/v1/auth/google/basic/callback
GOOGLE_BASIC_AUTH_REDIRECT=http://localhost:8000/api/v1/auth/google/basic/callback
GOOGLE_JAVASCRIPT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
GOOGLE_AES_KEY=
GOOGLE_REVOKE_CREDENTIALS_URL=https://oauth2.googleapis.com/revoke
GOOGLE_API_VERSION=v2
GOOGLE_API_SERVICE_NAME=drive
GOOGLE_SCOPES="openid https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/drive.metadata.readonly https://www.googleapis.com/auth/forms.body.readonly https://www.googleapis.com/auth/forms.responses.readonly"
OAUTHLIB_INSECURE_TRANSPORT=1
OAUTHLIB_RELAX_TOKEN_SCOPE=1

#Typeform
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
TYPEFORM_AUTH_URI=
TYPEFORM_TOKEN_URI=
TYPEFORM_SCOPE=
TYPEFORM_REDIRECT_URI
TYPEFORM_API_URI=

# Auth
AUTH_JWT_SECRET=
AUTH_AES_HEX_KEY=
ORGANIZATION_NAME="Better Collected"
# Stripe (create test keys at https://dashboard.stripe.com/test/apikeys)
STRIPE_PRODUCT_ID=<YOUR_STRIPE_PRODUCT_ID>
STRIPE_SECRET=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>
STRIPE_SUCCESS_URL=http://localhost:8001/api/v1/stripe/plans
STRIPE_CANCEL_URL=http://localhost:8001/api/v1/stripe/plans
STRIPE_RETURN_URL=http://localhost:8001/api/v1/stripe/plans
#Sentry (optional)
SENTRY_DSN=


# Elastic APM
ELASTIC_APM_API_KEY=
ELASTIC_APM_SERVICE_NAME=
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_ENVIRONMENT=
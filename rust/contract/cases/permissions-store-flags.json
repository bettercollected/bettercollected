{
 "group": "permissions",
 "description": "Every feature switch the store can hold, on in the store only (the four held in the environment are not store keys and stay off).",
 "store": {
  "FIELD_RULES_ENABLED": true,
  "CHOICE_LOGIC_ENABLED": true,
  "SAVE_DRAFTS_ENABLED": true,
  "CAPTCHA_ENABLED": true,
  "CSV_IMPORT_ENABLED": true,
  "NEW_QUESTION_TYPES_ENABLED": true,
  "ADDRESS_QUESTION_ENABLED": true,
  "ADDRESS_LOOKUP_ENABLED": true,
  "SIGNATURE_QUESTION_ENABLED": true,
  "OPTION_SOURCES_ENABLED": true,
  "REUSABLE_SECTIONS_ENABLED": true,
  "LAYOUT_CONTAINERS_ENABLED": true,
  "DAYBREAK_PRESET_ENABLED": true,
  "FORM_REVISIONS_UI_ENABLED": true,
  "AUDIT_LOG_UI_ENABLED": true,
  "RESPONSE_REVISIONS_ENABLED": true,
  "SUBMISSIONS_API_ENABLED": true,
  "FORM_EMBED_ENABLED": true,
  "APP_THEME_PIGMENT_ENABLED": true
 },
 "cases": [
  {
   "name": "store-flags:{who}@{w}",
   "method": "GET",
   "path": "/api/v1/workspaces/{ws.{w}}/permissions",
   "headers": {
    "Cookie": "Authorization={token.{who}}"
   },
   "matrix": {
    "who": [
     "owner",
     "viewer",
     "stranger"
    ],
    "w": [
     "main"
    ]
   },
   "served_by": "rust"
  }
 ]
}

{
 "group": "permissions",
 "description": "SETTINGS_STORE=required with the secrets in the environment and a tampered switch row: not critical, both keep serving.",
 "store": {
  "SSO_ENABLED": true,
  "TOTP_ENABLED": true
 },
 "tamper": [
  {
   "op": "value",
   "key": "TOTP_ENABLED",
   "value": false
  }
 ],
 "env": {
  "SETTINGS_STORE": "required"
 },
 "cases": [
  {
   "name": "store-required-env:{who}@{w}",
   "method": "GET",
   "path": "/api/v1/workspaces/{ws.{w}}/permissions",
   "headers": {
    "Cookie": "Authorization={token.{who}}"
   },
   "matrix": {
    "who": [
     "owner",
     "viewer",
     "stranger",
     "both_owner"
    ],
    "w": [
     "main",
     "both"
    ]
   }
  },
  {
   "name": "store-required-env-rust:{who}@{w}",
   "method": "GET",
   "path": "/api/v1/workspaces/{ws.{w}}/permissions",
   "headers": {
    "Cookie": "Authorization={token.{who}}"
   },
   "matrix": {
    "who": [
     "owner",
     "viewer",
     "stranger"
    ],
    "w": [
     "main"
    ]
   },
   "served_by": "rust"
  }
 ]
}

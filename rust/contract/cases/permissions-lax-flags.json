{
 "group": "permissions",
 "description": "Policy flags and membership flags stored in the spellings pydantic accepts (\"true\", \"Yes\", 1, 1.0, ...): Python enforces them, so the edge must. Rows whose flag pydantic refuses (\"maybe\", 2, null for a plain bool) cannot be read by Python either: the edge hands those requests to Python, so its answer stands.",
 "env": {
  "TOTP_ENABLED": "true",
  "SSO_ENABLED": "true"
 },
 "cases": [
  {
   "name": "lax:{x}",
   "method": "GET",
   "path": "/api/v1/workspaces/{ws.{x}}/permissions",
   "headers": {
    "Cookie": "Authorization={token.{x}}"
   },
   "matrix": {

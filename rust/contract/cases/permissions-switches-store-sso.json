{
 "group": "permissions",
 "description": "TOTP_ENABLED explicit off in the environment, SSO_ENABLED on for Python only.",
 "env": {
  "TOTP_ENABLED": "false"
 },
 "python_env": {
  "SSO_ENABLED": "true"
 },
 "cases": [
  {
   "name": "store-sso:{who}@{w}",
   "method": "GET",
   "path": "/api/v1/workspaces/{ws.{w}}/permissions",
   "headers": {
    "Cookie": "Authorization={token.{who}}"
   },
   "matrix": {
    "who": [
     "totp_owner",
     "totp_admin",
     "both_owner",
     "sso_owner",
     "owner",
     "viewer",
     "stranger"
    ],
    "w": [
     "main",
     "totp",
     "sso",
     "both"
    ]
   },
   "served_by": "python"
  }
 ]
}
